#!/usr/bin/env python3
"""tokoro-music — open the music player chosen during setup.

TEST FEATURE (docs/experimental.md). It never installs anything: it reports
which of the offered players are present and launches the configured one, so a
wrong default is one command away from being diagnosed.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys

SHARE = os.environ.get("TOKORO_SHARE", "/usr/share/tokoro")
ETC = os.environ.get("TOKORO_ETC", "/etc/tokoro")


def load_slot() -> dict:
    with open(os.path.join(SHARE, "wizard", "apps.json"), encoding="utf-8") as fh:
        return json.load(fh)["slots"]["music"]


def configured() -> str:
    try:
        with open(os.path.join(ETC, "features.json"), encoding="utf-8") as fh:
            return json.load(fh).get("apps", {}).get("music", "")
    except (OSError, json.JSONDecodeError):
        return ""


def installed_flatpaks() -> set[str]:
    if not shutil.which("flatpak"):
        return set()
    try:
        result = subprocess.run(
            ["flatpak", "list", "--app", "--columns=application"],
            capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return set()
    return set(result.stdout.split())


def find(slot: dict, wanted: str) -> dict:
    return next((opt for opt in slot["options"] if opt["id"] == wanted), {})


def cmd_list(slot: dict) -> int:
    chosen = configured() or slot["default"]
    have = installed_flatpaks()
    print(f"Music players (configured: {chosen})")
    for option in slot["options"]:
        flatpak = option.get("flatpak", "")
        if flatpak:
            state = "installed" if flatpak in have else "missing"
        else:
            state = "manual"
        marker = "  <- configured" if option["id"] == chosen else ""
        print(f"  {option['id']:<10} {option['name']:<12} {state:<9}{marker}")
    print("\nChange it by re-running the wizard, or set apps.music in "
          "/etc/tokoro/features.json.")
    return 0


def cmd_open(slot: dict, path: str | None) -> int:
    chosen = configured() or slot["default"]
    option = find(slot, chosen)
    if not option:
        print(f"configured player {chosen!r} is not in apps.json", file=sys.stderr)
        return 1
    flatpak = option.get("flatpak", "")
    if not flatpak:
        homepage = option.get("homepage", "")
        print(f"{option['name']} is installed manually: {homepage}")
        if homepage and shutil.which("xdg-open"):
            subprocess.run(["xdg-open", homepage], check=False)
        return 0
    if flatpak not in installed_flatpaks():
        print(f"{option['name']} ({flatpak}) is not installed.", file=sys.stderr)
        print(f"install it with: flatpak install --user flathub {flatpak}",
              file=sys.stderr)
        return 1
    cmd = ["flatpak", "run", flatpak]
    if path:
        if not os.path.exists(path):
            print(f"no such file or directory: {path}", file=sys.stderr)
            return 1
        cmd.append(os.path.abspath(path))
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as err:
        print(f"could not start {option['name']}: {err}", file=sys.stderr)
        return 1
    print(f"opened {option['name']}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Open the Tokoro music player")
    parser.add_argument("--list", action="store_true", help="show players and which are installed")
    parser.add_argument("--play", metavar="PATH", help="open a file or folder in the player")
    args = parser.parse_args()

    try:
        slot = load_slot()
    except (OSError, json.JSONDecodeError) as err:
        print(f"cannot read apps.json: {err}", file=sys.stderr)
        return 1
    if args.list:
        return cmd_list(slot)
    return cmd_open(slot, args.play)


if __name__ == "__main__":
    sys.exit(main())
