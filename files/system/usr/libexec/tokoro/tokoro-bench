#!/usr/bin/env python3
"""tokoro-bench — built-in benchmark with a gaming mode.

Measures CPU, memory, disk and (when available) GPU, produces a 0-100 score that
is comparable across machines, and maps it onto the tier the hardware can carry.
`tokoro bench play <game>` switches to gaming mode and launches through Steam.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time

EXEC = os.environ.get("TOKORO_EXEC", "/usr/libexec/tokoro")
STATE = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "tokoro", "bench")
TIERS = ["ultra-performance", "performance", "balanced", "quality", "ultra-quality"]


def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def run(cmd: list[str], timeout: int = 120) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)


def cpu_bench(seconds: float = 1.0) -> tuple[float, float]:
    """Integer loop; returns (single-thread, all-thread) iterations per second."""

    def spin(iters: int) -> float:
        n = 0
        start = time.perf_counter()
        while time.perf_counter() - start < seconds:
            for i in range(iters):
                n += (i * i) % 7
        elapsed = time.perf_counter() - start
        return n / elapsed

    single = spin(200_000)
    # Python threads do not scale; run multiple processes for a real multi-core number.
    procs = os.cpu_count() or 1
    start = time.perf_counter()
    children = [
        subprocess.Popen([sys.executable, "-c",
                          "import time\ns=time.perf_counter()\nn=0\n"
                          "while time.perf_counter()-s<%f:\n"
                          "    for i in range(200000): n+=(i*i)%%7\n" % seconds])
        for _ in range(min(procs, 8))
    ]
    for child in children:
        child.wait()
    elapsed = time.perf_counter() - start
    multi = single * min(procs, 8) * (seconds / elapsed)
    return single, multi


def mem_bench() -> float:
    """Rough memory bandwidth in GB/s via a large byte buffer copy."""
    size = 64 * 1024 * 1024
    src = b"\x01" * size
    start = time.perf_counter()
    for _ in range(8):
        dst = bytearray(src)
        dst[0] = 0
    elapsed = max(time.perf_counter() - start, 1e-6)
    return (size * 8 * 2) / elapsed / (1024**3)


def disk_bench(size_mb: int = 32) -> float:
    """Write throughput in MB/s against the user's cache directory."""
    os.makedirs(STATE, exist_ok=True)
    path = os.path.join(STATE, "disk.tmp")
    payload = os.urandom(size_mb * 1024 * 1024)
    start = time.perf_counter()
    with open(path, "wb") as fh:
        fh.write(payload)
        fh.flush()
        os.fsync(fh.fileno())
    elapsed = max(time.perf_counter() - start, 1e-6)
    os.unlink(path)
    return len(payload) / elapsed / (1024**2)


def gpu_bench() -> dict:
    info: dict = {"available": False}
    if have("vulkaninfo"):
        result = run(["vulkaninfo", "--summary"], timeout=60)
        for line in result.stdout.splitlines():
            if "deviceName" in line:
                info["device"] = line.split("=")[-1].strip()
                info["available"] = True
                break
    if have("vkmark"):
        result = run(["vkmark", "--duration", "5", "--benchmark", "tests/vkmark"], timeout=120)
        for line in result.stdout.splitlines():
            if "vkmark score" in line.lower():
                info["vkmark"] = line.strip()
    return info


# Reference points for a modern 8-core desktop; the weights add up to 100 with
# the GPU component. Calibrate against a known machine before changing them.
CPU_SINGLE_REF = 40_000_000
CPU_MULTI_REF = 250_000_000
MEM_REF_GBPS = 25.0
DISK_REF_MBPS = 1500.0


def score_cpu(single: float, multi: float) -> float:
    return min(1.0, (single / CPU_SINGLE_REF) * 0.5 + (multi / CPU_MULTI_REF) * 0.5) * 40


def score_mem(gbps: float) -> float:
    return min(1.0, gbps / MEM_REF_GBPS) * 15


def score_disk(mbps: float) -> float:
    return min(1.0, mbps / DISK_REF_MBPS) * 15


def score_gpu() -> tuple[float, dict]:
    """Reuse the hardware detector so the benchmark and tier agree on the GPU."""
    result = run([os.path.join(EXEC, "tokoro-detect-hardware"), "--json"], timeout=60)
    try:
        hardware = json.loads(result.stdout)
    except json.JSONDecodeError:
        return 0.0, {}
    gpu_score = hardware.get("breakdown", {}).get("gpu", 0)
    return min(30.0, (gpu_score / 55.0) * 30), hardware


def tier_for_score(score: float) -> str:
    for index, tier in enumerate(TIERS):
        if score <= (index + 1) * 20:
            return tier
    return TIERS[-1]


def current_tier() -> str:
    state = os.environ.get("TOKORO_STATE_FILE", "/etc/tokoro/tier.conf")
    try:
        with open(state, encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("TOKORO_TIER="):
                    return line.split("=", 1)[1].strip().strip("\"'")
    except OSError:
        pass
    return "balanced"


def gaming_mode() -> None:
    run([os.path.join(EXEC, "tokoro-mode"), "gaming"], timeout=60)


def cmd_run(args: argparse.Namespace) -> int:
    if args.gaming:
        gaming_mode()
    duration = 0.4 if args.quick else 1.0
    single, multi = cpu_bench(duration)
    mem = mem_bench()
    disk = disk_bench(8 if args.quick else 32)
    gpu = gpu_bench()
    gpu_points, hardware = score_gpu()
    score = score_cpu(single, multi) + score_mem(mem) + score_disk(disk) + gpu_points
    result = {
        "schema": 1,
        "score": round(score, 1),
        "can_carry_tier": tier_for_score(score),
        "hardware_tier": hardware.get("recommended_tier"),
        "gpu_points": round(gpu_points, 1),
        "current_tier": current_tier(),
        "cpu": {"single": round(single), "multi": round(multi)},
        "memory_gbps": round(mem, 1),
        "disk_mbps": round(disk, 1),
        "gpu": gpu,
        "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "last.json"), "w", encoding="utf-8") as fh:
        json.dump(result, fh, indent=2)
        fh.write("\n")

    if args.json:
        print(json.dumps(result, indent=2))
        return 0

    print(f"Tokoro benchmark — score {result['score']}/100")
    print(f"  CPU   {result['cpu']['single']:,} / {result['cpu']['multi']:,} it/s")
    print(f"  RAM   {result['memory_gbps']} GB/s")
    print(f"  disk  {result['disk_mbps']} MB/s")
    print(f"  GPU   {gpu.get('device', 'not detected')} (+{result['gpu_points']} pts)")
    print(f"  can carry tier: {result['can_carry_tier']} (current: {result['current_tier']})")
    if result["score"] < 100 and result["can_carry_tier"] != result["current_tier"]:
        print("  note: benchmark and tier disagree; `tokoro tier detect` gives the "
              "hardware-based recommendation")
    return 0


def cmd_play(args: argparse.Namespace) -> int:
    games = os.path.join(EXEC, "tokoro-games")
    info = run([games, "info", args.game], timeout=30)
    if info.returncode != 0:
        print(info.stdout.strip() or info.stderr.strip(), file=sys.stderr)
        return info.returncode
    print(info.stdout.strip())
    gaming_mode()
    appid = args.game
    if not appid.isdigit():
        parsed = run([games, "info", args.game, "--json"], timeout=30)
        try:
            appid = json.loads(parsed.stdout).get("id", args.game)
        except json.JSONDecodeError:
            appid = args.game
    if have("steam"):
        url = f"steam://rungameid/{appid}"
        print(f"launching {url}")
        return run(["steam", url], timeout=30).returncode
    print(f"open Steam and launch app {appid}; gaming mode is active")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Tokoro OS benchmark")
    sub = parser.add_subparsers(dest="cmd")
    p = sub.add_parser("run", help="run the benchmark")
    p.add_argument("--json", action="store_true")
    p.add_argument("--quick", action="store_true")
    p.add_argument("--gaming", action="store_true", help="switch to gaming mode first")
    p = sub.add_parser("play", help="gaming mode + launch a known game")
    p.add_argument("game")
    args = parser.parse_args()
    if args.cmd == "play":
        return cmd_play(args)
    if args.cmd in (None, "run"):
        if args.cmd is None:
            args.json = False
            args.quick = False
            args.gaming = False
        return cmd_run(args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
